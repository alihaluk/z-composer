{
  "name": "z-composer",
  "private": true,
  "version": "1.7.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@types/file-saver": "^2.0.7",
    "bwip-js": "^4.11.4",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "i18next": "^25.8.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-i18next": "^16.5.4",
    "tailwind-merge": "^3.4.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist-lib",
    "conformance"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/z-composer.js"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "description": "Visual designer for ZPL receipt and invoice templates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alihaluk/z-composer.git"
  },
  "homepage": "https://alihaluk.github.io/z-composer/",
  "keywords": [
    "zpl",
    "zebra",
    "label",
    "receipt",
    "invoice",
    "designer",
    "react"
  ]
}
